{
  "schema_version": 1,
  "purpose": "Synthetic artifact audit plus bounded-loop controls; no native model trials",
  "audit_cases": [
    {
      "id": "A01",
      "rationale": "valid exact bytes",
      "files": {
        "payload.txt": "current evidence\n"
      },
      "registry": {
        "schema_version": 1,
        "artifacts": [
          {
            "id": "one",
            "path": "payload.txt",
            "sha256": "bb83370a57f3e4a7196bfadd8675d874bc47df8a99f4b709b5499b01369f2366"
          }
        ]
      },
      "expected": "ok"
    },
    {
      "id": "A02",
      "rationale": "empty file is valid content",
      "files": {
        "payload.txt": ""
      },
      "registry": {
        "schema_version": 1,
