  "gate_cases": [
    {
      "id": "G01",
      "rationale": "real suite improvement still requires separate review",
      "scenario": "gain",
      "expected": "review_pending"
    },
    {
      "id": "G02",
      "rationale": "extra prose or equal scores provide no measured gain",
      "scenario": "no_gain",
      "expected": "no_gain"
    },
    {
      "id": "G03",
      "rationale": "higher total cannot hide loss on an existing control",
      "scenario": "regression",
      "expected": "regression"
    },
    {
      "id": "G04",
      "rationale": "different suite hash invalidates comparison",
      "scenario": "suite_changed",
      "expected": "incomparable"
    },
    {
      "id": "G05",
      "rationale": "missing observation cannot count as a pass",
      "scenario": "missing_row",
      "expected": "invalid_evidence"
    },
    {
      "id": "G06",
      "rationale": "changed result bytes invalidate frozen receipt",
      "scenario": "tampered_report",
      "expected": "invalid_evidence"
    },
    {
      "id": "G07",
      "rationale": "elapsed deadline prevents further cycle work",
      "scenario": "deadline",
      "expected": "budget_exhausted"
    },
    {
      "id": "G08",
      "rationale": "new cycle cannot erase repairs beyond the root limit",
      "scenario": "repair_overrun",
      "expected": "budget_exhausted"
    },
    {
      "id": "G09",
      "rationale": "recursive depth cannot exceed original cycle allowance",
      "scenario": "cycle_overrun",
      "expected": "budget_exhausted"
    }
  ]
}
