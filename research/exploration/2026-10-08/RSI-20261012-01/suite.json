      "registry": {
        "schema_version": 1,
        "artifacts": [
          {
            "id": "one",
            "path": "payload.txt",
            "sha256": "bb83370a57f3e4a7196bfadd8675d874bc47df8a99f4b709b5499b01369f2366"
          }
